{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "statmon",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Served from a custom domain on the noahpn.dev zone. The default
  // *.workers.dev subdomain is a free shared host anyone can register, so it's
  // heavily used for phishing, and LinkedIn blocks the whole domain: a link to
  // the site couldn't be posted there at all. Cloudflare creates the DNS record
  // itself, because the zone is on the same account.
  "routes": [{ "pattern": "statmon.noahpn.dev", "custom_domain": true }],
  // Both are explicit, because declaring `routes` already turns them off by
  // default, and Wrangler warns on every deploy that it's making that choice
  // for you. Saying it here silences the warnings, and means the file states
  // what's true rather than leaving it to a default. The same settings the
  // portfolio uses, and they also clear the workers.dev TLS, HTTPS, and HSTS
  // security warnings.
  "workers_dev": false,
  "preview_urls": false,
}
