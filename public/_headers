# Response headers for the deployed site. Cloudflare's static-assets runtime
# reads this file from the build output; it is copied verbatim from `public/`.
#
# The CSP is unusually strict because the site can afford it: everything it
# needs is same-origin. The data is baked into the bundle at build time, the
# sprites, artwork, and both webfonts are committed to the repo, and there's
# exactly one script, Vite's module entry. Nothing is fetched from anyone at
# runtime, so nothing has to be allowed.
#
# There's no `'unsafe-inline'` anywhere, including for styles, and that's the
# part worth explaining, because it looks wrong. The app sets every type colour
# through React's `style` prop (`typeColorVar`, `tintFor`, `typeFill`), and the
# obvious assumption is that CSP counts those as inline styles. It doesn't:
# React assigns individual properties through the CSSOM
# (`node.style.setProperty`), which CSP's `style-src` doesn't govern. It
# governs `<style>` elements, `style=` attributes present in the HTML, and
# `cssText`. This app has none of those, so the directive costs nothing.
#
# Measured rather than assumed, in both directions: every route loads under
# exactly this policy with zero violations, and the same harness reports
# violations on every route when `img-src` is tightened to `'none'`, so the
# clean result isn't a blind check.
#
# The one thing to re-check if the app ever server-renders: server rendering
# emits real `style=` attributes, which this policy would block.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# The hashed build assets are immutable: their name changes when they do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The vendored fonts, sprites, and artwork are cached as immutable too.
# `vendor:images` never replaces a file that already exists, and a new Pokémon
# arrives as a new file.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/sprites/*
  Cache-Control: public, max-age=31536000, immutable
/artwork/*
  Cache-Control: public, max-age=31536000, immutable
