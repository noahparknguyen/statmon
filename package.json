{
  "name": "statmon",
  "private": true,
  "version": "1.0.0",
  "description": "A set of Pok\u00e9mon tools: a head-to-head base-stat comparison, a sortable full-dex table, and a generation-aware type chart.",
  "license": "MIT",
  "author": "Noah Park-Nguyen (https://github.com/noahparknguyen)",
  "homepage": "https://statmon.noahparknguyen.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahparknguyen/statmon.git"
  },
  "bugs": "https://github.com/noahparknguyen/statmon/issues",
  "keywords": [
    "pokemon",
    "pokeapi",
    "stat-comparison",
    "pokedex",
    "type-chart",
    "react",
    "vite",
    "tailwindcss",
    "react-router",
    "cloudflare-workers"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "build:data": "node scripts/build-data.mjs",
    "vendor:images": "node scripts/vendor-images.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "sweep:widths": "node scripts/sweep-widths.mjs",
    "shoot:docs": "node scripts/shoot-docs.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.115.0"
  }
}
